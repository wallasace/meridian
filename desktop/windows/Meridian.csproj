<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>Meridian</AssemblyName>
    <RootNamespace>Meridian</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Wallace Ferreira de Abreu</Company>
    <Authors>Wallace Ferreira de Abreu</Authors>
    <Product>Meridian World Clock</Product>
    <Copyright>Copyright © 2026 Wallace Ferreira de Abreu</Copyright>
    <ApplicationIcon>meridian.ico</ApplicationIcon>
    <!-- One self-contained .exe: the person unzips and runs, no .NET install. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app page travels next to the executable. -->
    <None Include="..\..\index.html" CopyToOutputDirectory="PreserveNewest" Link="index.html" />
    <None Include="meridian.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('meridian.ico')" />
  </ItemGroup>

</Project>
